#!/usr/bin/env node
import path from 'node:path'
import { loadConfig, CONFIG_DIR, PATHS } from '../daemon/config.js'
import { runDoctor } from './doctor.js'

const config = loadConfig()
const BASE = `http://127.0.0.1:${config.port}`

const PHASE_LABEL = {
  IDLE: 'idle',
  WORK: 'work',
  SHORT_BREAK: 'short break',
  LONG_BREAK: 'long break',
}

async function call(method, route, body, timeoutMs = 3000) {
  let res
  try {
    res = await fetch(BASE + route, {
      method,
      headers: body ? { 'content-type': 'application/json' } : undefined,
      body: body ? JSON.stringify(body) : undefined,
      signal: AbortSignal.timeout(timeoutMs),
    })
  } catch {
    console.error('focus: the daemon is not running. Start it with:')
    console.error('  systemctl --user start focus-nudge')
    process.exit(1)
  }
  const data = await res.json().catch(() => ({}))
  if (!res.ok) {
    console.error(`focus: ${data.error || res.statusText}`)
    process.exit(1)
  }
  return data
}

// Resolves a case-insensitive prefix against the daemon's Linear projects. An
// exact name wins; otherwise exactly one project must start with the prefix.
async function pickProject(prefix) {
  const linear = await call('GET', '/linear', undefined, 15000)
  if (!linear.enabled) {
    console.error('focus: Linear sync is off (no LINEAR_API_KEY), so there are no projects to pick from')
    process.exit(1)
  }
  const want = prefix.toLowerCase()
  const exact = linear.projects.filter(p => p.name.toLowerCase() === want)
  const matches = exact.length ? exact : linear.projects.filter(p => p.name.toLowerCase().startsWith(want))
  if (matches.length === 1) return matches[0]
  const listed = matches.length ? matches : linear.projects
  console.error(matches.length
    ? `focus: "${prefix}" matches more than one project:`
    : `focus: no Linear project starts with "${prefix}". The projects are:`)
  for (const p of listed) console.error(`  ${p.name}`)
  process.exit(1)
}

function formatDuration(ms) {
  const sign = ms < 0 ? '-' : ''
  const total = Math.floor(Math.abs(ms) / 1000)
  const m = Math.floor(total / 60)
  const s = String(total % 60).padStart(2, '0')
  return `${sign}${m}:${s}`
}

// Nudge-offs run for hours, so this one shows h:mm:ss once past an hour.
function formatLong(ms) {
  const total = Math.max(0, Math.floor(ms / 1000))
  const h = Math.floor(total / 3600)
  const m = Math.floor((total % 3600) / 60)
  const s = String(total % 60).padStart(2, '0')
  return h ? `${h}:${String(m).padStart(2, '0')}:${s}` : `${m}:${s}`
}

function nudgingLine(v) {
  if (v.nudging !== false) return 'nudging on'
  if (v.nudgeOffIndefinite || v.nudgeOffUntil === null) return 'nudging off until you turn it back on'
  return `nudging off — ${formatLong(v.nudgeOffUntil - v.serverTime)} left`
}

// "2h", "90m", "1.5h", or a bare number of hours.
function parseDuration(input) {
  const m = String(input ?? '').trim().match(/^(\d+(?:\.\d+)?)\s*([hm]?)$/i)
  if (!m) return null
  const value = Number(m[1])
  if (!Number.isFinite(value) || value <= 0) return null
  return m[2].toLowerCase() === 'm' ? value / 60 : value
}

// Task ids are the small integers `focus status` prints. Anything else is a typo,
// and a typo must not look like it worked.
function taskId(raw, sub) {
  const n = Number(raw)
  if (raw === undefined || String(raw).trim() === '' || !Number.isInteger(n) || n <= 0) {
    console.error(`focus: "focus task ${sub}" needs a task id. Try "focus task ${sub} 1", or "focus task" to list them.`)
    process.exit(1)
  }
  return n
}

function printStatus(v) {
  const label = PHASE_LABEL[v.phase] ?? v.phase
  let line = label
  if (v.remainingMs !== null) {
    line += v.paused
      ? ` — paused, ${formatDuration(v.remainingMs)} left`
      : v.overrun
        ? ` — ran over by ${formatDuration(-v.remainingMs)}`
        : ` — ${formatDuration(v.remainingMs)} left`
  }
  if (v.phase === 'WORK' || v.phase === 'SHORT_BREAK') {
    line += `  [block ${v.blocksCompleted + (v.phase === 'WORK' ? 1 : 0)}/${v.blocksPerCycle}]`
  }
  console.log(line)
  console.log(nudgingLine(v))

  if (v.tasks.length) {
    console.log()
    for (const t of v.tasks) {
      const tag = t.linear?.identifier ? `  ${t.linear.identifier}` : t.linearPending ? '  (Linear pending)' : ''
      console.log(`  ${t.done ? '[x]' : '[ ]'} ${t.id}  ${t.text}${tag}`)
    }
  }
  if (v.queueDepth) {
    console.log()
    console.log(`  ${v.queueDepth} link${v.queueDepth === 1 ? '' : 's'} saved for when you next switch nudging off`)
  }
  if (v.persisted === false) {
    console.log()
    console.log('  ! state is not reaching disk — changes will be lost on restart')
    console.log('    check: systemctl --user status focus-nudge')
  }
}

const HELP = `focus — a pause, a quote, and your unfinished tasks before a distraction.

usage: focus [command]

  status                 current phase, countdown, open tasks   (also: no args)
  start                  begin a work block, or resume a paused one
  pause                  pause the running phase
  skip                   advance to the next phase
  stop                   back to idle, clears the cycle
  break                  begin a long break
  off [duration]         stop nudging: 2h, 90m, a bare number of hours, or no
                         duration for "until I turn it back on". The timer is
                         not touched — a running work block keeps running.
  on                     turn nudging back on

  task                   list the micro-tasks
  task <text>            add a micro-task (and a Linear issue, when Linear is on)
  task <text> --project <name>
                         file the Linear issue under a project; any unique
                         prefix of its name works, in any case
  task done <id>         tick one off (also: task toggle <id>)
  task rm <id>           remove one (cancels its Linear issue if it is open)
  task clear             empty the list (ids restart at 1 once it is empty);
                         Linear is left untouched
  task clear done        remove only the ticked-off tasks

  sites                  list the watched domains
  sites add <domain>     watch another domain
  sites remove <domain>  stop watching one

  queue                  list links saved for the next time you switch nudging off
  queue drain            open them now and empty the queue

  stats                  blocks today, last 7 days, all time, and a daily history
  stats <n>              show the last <n> days of history (default 14)
  doctor                 diagnose a machine where the daemon or unit isn't working
  --help, -h, help       this text

Phases never advance on their own: an expired block waits for you. Nudging and
the timer are independent switches: watched sites are nudged whenever nudging
is on, whatever the timer is doing, and open freely while it is off. Turning
nudging off opens any saved links. See \`focus sites\`.

A work block or break finishing on its own plays a sound alongside the desktop
notification — that is the one moment you are likely not watching the screen.
Actions you trigger yourself (start, skip, on, off, break) stay silent. Configure
or disable this under "sounds" in config.json; see \`focus doctor\` to check
whether sounds are enabled and the configured sound files exist.

The daemon holds all state. Start or check it with:
  systemctl --user status focus-nudge
`

const [cmd, ...rest] = process.argv.slice(2)

switch (cmd) {
  case '--help':
  case '-h':
  case 'help':
    console.log(HELP)
    break
  case 'start':
    printStatus(await call('POST', '/timer', { action: 'start' }))
    break
  case 'skip':
  case 'next':
    printStatus(await call('POST', '/timer', { action: 'skip' }))
    break
  case 'pause':
    printStatus(await call('POST', '/timer', { action: 'pause' }))
    break
  case 'stop':
    printStatus(await call('POST', '/timer', { action: 'stop' }))
    break
  case 'break':
    printStatus(await call('POST', '/timer', { action: 'breakLong' }))
    break
  case 'off': {
    if (rest[0] === undefined) {
      printStatus(await call('POST', '/nudging', { action: 'off', indefinite: true }))
      break
    }
    const hours = parseDuration(rest[0])
    if (hours === null) {
      console.error('focus: could not read that duration. Try "focus off 2h", "focus off 90m", or just "focus off".')
      process.exit(1)
    }
    printStatus(await call('POST', '/nudging', { action: 'off', hours }))
    break
  }
  case 'on':
    printStatus(await call('POST', '/nudging', { action: 'on' }))
    break
  case undefined:
  case 'status':
    printStatus(await call('GET', '/state'))
    break
  case 'task': {
    const [sub, ...words] = rest
    if (!sub) { printStatus(await call('GET', '/state')); break }
    if (sub === 'done' || sub === 'toggle' || sub === 'rm' || sub === 'remove') {
      // Without an id this sent id: NaN, which JSON.stringify writes as null. The
      // daemon then matched no task and returned the unchanged state with a 200,
      // so `focus task done` printed the list and silently did nothing.
      const id = taskId(words[0], sub)
      const action = sub === 'done' || sub === 'toggle' ? 'toggle' : 'remove'
      printStatus(await call('POST', '/tasks', { action, id }))
    } else if (sub === 'clear') {
      // `task clear` empties everything; `task clear done` keeps what is open.
      const action = words[0] === 'done' ? 'clearDone' : 'clear'
      printStatus(await call('POST', '/tasks', { action }))
    } else {
      const all = [sub, ...words]
      const at = all.indexOf('--project')
      let project
      if (at !== -1) {
        const prefix = all.slice(at + 1).join(' ').trim()
        all.splice(at)
        if (!prefix) {
          console.error('focus: --project needs a project name, e.g. focus task fix the board --project pcb')
          process.exit(1)
        }
        project = await pickProject(prefix)
      }
      printStatus(await call('POST', '/tasks', { action: 'add', text: all.join(' '), project }))
    }
    break
  }
  case 'sites': {
    const [sub, domain] = rest
    if (!sub) {
      const v = await call('GET', '/state')
      for (const s of v.sites) console.log(`  ${s}`)
      break
    }
    if (sub !== 'add' && sub !== 'remove') {
      console.error('focus: use "focus sites add <domain>" or "focus sites remove <domain>".')
      process.exit(1)
    }
    if (!domain) {
      console.error(`focus: which domain? Try "focus sites ${sub} reddit.com".`)
      process.exit(1)
    }

    // The daemon canonicalises entries and rejects anything without a dot, but a
    // rejection returns the unchanged state with a 200 — indistinguishable from
    // success unless the count is compared. `focus sites add com` used to print
    // the untouched list and look like it had worked. The popup has compared
    // before/after since its own review; the CLI never got it.
    const before = await call('GET', '/state')
    const v = await call('POST', '/sites', { action: sub, site: domain })
    for (const s of v.sites) console.log(`  ${s}`)

    if (v.sites.length === before.sites.length) {
      console.error()
      if (sub === 'add') {
        // Keep what they typed visible so it can be corrected rather than retyped.
        console.error(`focus: "${domain}" was not added — check it is a full domain, or it may already be listed.`)
      } else {
        console.error(`focus: "${domain}" was not removed — it does not appear to be listed.`)
      }
      process.exit(1)
    }
    break
  }
  case 'queue': {
    if (rest[0] === 'drain') {
      printStatus(await call('POST', '/queue', { drain: true }))
      break
    }
    const v = await call('GET', '/state')
    if (!v.queue.length) console.log('  nothing saved')
    for (const q of v.queue) console.log(`  ${q.title || q.url}\n    ${q.url}`)
    break
  }
  case 'stats': {
    const s = await call('GET', '/stats')
    const t = s.totals
    const days = Number(rest[0]) > 0 ? Math.floor(Number(rest[0])) : 14

    console.log(`  today              ${t.today} block${t.today === 1 ? '' : 's'}`)
    console.log(`  last 7 days        ${t.last7}`)
    console.log(`  all time           ${t.blocksCompleted}`)
    console.log()
    console.log(`  continued anyway   ${t.nudgesContinued}`)
    console.log(`  saved for later    ${t.savedForLater}`)
    console.log(`  queues drained     ${t.queueDrained}`)

    const keys = Object.keys(t.byDay).filter(k => k !== 'unknown').sort().reverse().slice(0, days)
    if (keys.length) {
      const most = Math.max(...keys.map(k => t.byDay[k]))
      console.log()
      console.log(`  last ${keys.length} day${keys.length === 1 ? '' : 's'} with blocks`)
      for (const k of keys) {
        const n = t.byDay[k]
        // Scale the bar to the busiest day so it stays readable in a terminal.
        const bar = '#'.repeat(Math.max(1, Math.round((n / most) * 24)))
        console.log(`    ${k}  ${String(n).padStart(3)}  ${bar}`)
      }
    }
    if (t.byDay.unknown) {
      console.log()
      console.log(`  ${t.byDay.unknown} block(s) from log lines with no usable timestamp`)
    }
    break
  }
  case 'doctor': {
    const code = await runDoctor({
      config,
      repoRoot: path.join(import.meta.dirname, '..'),
      paths: {
        dir: CONFIG_DIR,
        files: { 'config.json': PATHS.config, 'quotes.txt': PATHS.quotes, 'state.json': PATHS.state, 'log.jsonl': PATHS.log },
      },
    })
    if (code !== 0) process.exit(code)
    break
  }
  default:
    console.error(`focus: unknown command "${cmd}"`)
    console.error('Try "focus --help".')
    process.exit(1)
}
